#!/usr/bin/env bash
#
# sync-org — keep a local clone of every repo in a GitHub organization.
#
# Default: clone any org repos that are not present locally.
# --update: additionally fetch/update the repos you already have.
#
# Usage:
#   ./sync-org                # clone missing repos
#   ./sync-org --update       # clone missing + update existing
#   ./sync-org -j 8           # parallelism for cloning (default 5)
#
# Env overrides:
#   ORG=Hestia-Technology  DEST=~/repos  BIN=gh
#
set -euo pipefail

ORG="${ORG:-Hestia-Technology}"
BIN="${BIN:-gh}"
JOBS=5
DO_UPDATE=0

# Default destination is the parent of this script's directory (i.e. ~/repos).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEST="${DEST:-$(cd "$SCRIPT_DIR/.." && pwd)}"

while [ $# -gt 0 ]; do
  case "$1" in
    --update)   DO_UPDATE=1 ;;
    -j|--jobs)  JOBS="${2:?missing value for $1}"; shift ;;
    -h|--help)  sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

command -v "$BIN" >/dev/null 2>&1 || { echo "error: '$BIN' not found (install the GitHub CLI)." >&2; exit 1; }
"$BIN" auth status >/dev/null 2>&1 || { echo "error: not logged in. Run: $BIN auth login" >&2; exit 1; }

mkdir -p "$DEST"
cd "$DEST"

echo "Org:      $ORG"
echo "Dest:     $DEST"
echo "Updating: $([ "$DO_UPDATE" -eq 1 ] && echo yes || echo no)"
echo

# All repo names in the org.
mapfile -t REPOS < <("$BIN" repo list "$ORG" --limit 1000 --json name --jq '.[].name' | sort)

missing=()
present=()
for name in "${REPOS[@]}"; do
  if [ -d "$name/.git" ]; then present+=("$name"); else missing+=("$name"); fi
done

echo "Found ${#REPOS[@]} repo(s): ${#present[@]} present, ${#missing[@]} missing."
echo

clone_one() {
  local name="$1"
  if git clone --quiet "git@github.com:${ORG}/${name}.git" "$DEST/${name}" >"/tmp/sync-${name}.log" 2>&1; then
    echo "  cloned   $name"
  else
    echo "  FAILED   $name  (see /tmp/sync-${name}.log)"
  fi
}
export -f clone_one
export ORG DEST

if [ "${#missing[@]}" -gt 0 ]; then
  echo "Cloning missing repos..."
  printf '%s\n' "${missing[@]}" | xargs -P "$JOBS" -I{} bash -c 'clone_one "$@"' _ {}
  echo
fi

if [ "$DO_UPDATE" -eq 1 ] && [ "${#present[@]}" -gt 0 ]; then
  echo "Updating existing repos..."
  for name in "${present[@]}"; do
    if out=$(git -C "$DEST/$name" pull --ff-only --quiet 2>&1); then
      echo "  updated  $name"
    else
      echo "  SKIPPED  $name  ($(echo "$out" | head -1))"
    fi
  done
  echo
fi

echo "Done. Local org repos in $DEST: $(find "$DEST" -maxdepth 2 -name .git -type d | wc -l)"
